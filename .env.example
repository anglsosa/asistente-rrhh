# Obligatoria, la sacas gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
APP_ENVIRONMENT=development
# Opcional, segundos que espera al agente antes de responder 504 (por defecto 45)
APP_TIMEOUT_AGENTE_SEG=90
# Opcionales, por defecto se usan data/politicas y data/chroma de este repositorio
# APP_DATA_DIR=
# APP_CHROMA_DIR=
# APP_GEMINI_MODELO=gemini-3.5-flash
